{
  "name": "@orca/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orca tray app: the hub that owns every Ask.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm --filter orca-cursor package && electron-vite build",
    "build:shim": "go build -o resources/bin/agentd-hook ../../cmd/agentd-hook",
    "build:mcp": "pnpm --filter @orca/mcp build && mkdir -p resources/bin && cp ../../packages/mcp/dist/orca-mcp.mjs resources/bin/orca-mcp.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@orca/protocol": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
